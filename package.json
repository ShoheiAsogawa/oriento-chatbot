{
  "name": "orient-ai-chatbot",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "build": "pnpm --filter @orient/widget --filter @orient/admin build && pnpm prepare:assets && pnpm --filter @orient/worker build",
    "build:preview": "pnpm --filter @orient/worker exec wrangler deploy --dry-run --config ../preview/wrangler.jsonc --outdir ../preview/dist",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "knowledge:scrape": "python scripts/scrape-orient-knowledge.py",
    "knowledge:properties": "python scripts/scrape-orient-knowledge.py --property-only --individual-properties",
    "knowledge:catalog": "python scripts/build-rental-catalog.py && python scripts/build-sale-catalog.py && python scripts/build-guided-search-options.py",
    "knowledge:validate": "python scripts/validate-orient-knowledge.py",
    "privacy:pdf": "python3 scripts/render-privacy-policy-pdf.py",
    "knowledge:refresh:properties": "pnpm knowledge:properties && pnpm knowledge:catalog && pnpm knowledge:validate",
    "check": "pnpm -r check",
    "test": "pnpm --filter @orient/worker test",
    "deploy:production": "pnpm --filter @orient/worker exec wrangler deploy",
    "deploy:preview": "pnpm --filter @orient/worker exec wrangler deploy --config ../preview/wrangler.jsonc",
    "dev:worker": "pnpm --filter @orient/worker dev",
    "dev:admin": "pnpm --filter @orient/admin dev",
    "dev:widget": "pnpm --filter @orient/widget dev"
  }
}
