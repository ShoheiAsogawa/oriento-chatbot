{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "orient-chat-api",
  "account_id": "d2874089eebcda705bf220d39f117aec",
  "main": "src/index.ts",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 0.1, "invocation_logs": true },
    "traces": { "enabled": false, "head_sampling_rate": 0.1 }
  },
  "assets": {
    "directory": "./static",
    "binding": "STATIC_ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_ORIGINS": "https://orijyu.com,https://www.orijyu.com,https://orient-chat-preview.uken-shohei.workers.dev",
    "AI_SEARCH_INSTANCE": "orient-knowledge",
    "CLOUDFLARE_ACCOUNT_ID": "d2874089eebcda705bf220d39f117aec",
    "AI_GATEWAY_ID": "orient-chat",
    "GENERATION_MODEL": "gpt-5.4-nano",
    "DAILY_SESSION_LIMIT": "500",
    "DAILY_AI_REQUEST_LIMIT": "500",
    "DEV_ADMIN_BYPASS": "false"
  },
  "secrets": {
    "required": [
      "TURNSTILE_SECRET",
      "SESSION_SIGNING_KEY",
      "HASH_SALT",
      "PII_ENCRYPTION_KEY",
      "AI_GATEWAY_TOKEN",
      "KNOWLEDGE_SYNC_SECRET"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "orient-chat",
      "database_id": "c5e7d5ab-825f-4bae-b192-9a42f17cdf37",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AUDIT_ARCHIVE",
      "bucket_name": "orient-chat-audit"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "AUDIT_QUEUE", "queue": "orient-chat-audit" },
      { "binding": "CUSTOM_HOME_LEAD_QUEUE", "queue": "orient-chat-custom-home-leads" }
    ],
    "consumers": [
      { "queue": "orient-chat-audit", "max_batch_size": 50, "max_batch_timeout": 10 },
      { "queue": "orient-chat-custom-home-leads", "max_batch_size": 5, "max_batch_timeout": 10, "max_retries": 5 }
    ]
  },
  "send_email": [
    {
      "name": "CUSTOM_HOME_LEAD_EMAIL",
      "destination_address": "uken.shohei@gmail.com",
      "allowed_sender_addresses": ["no-reply@orijyu.com"]
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "AUDIT_LEDGER", "class_name": "AuditLedger" },
      { "name": "MAINTENANCE_SCHEDULER", "class_name": "MaintenanceScheduler" }
    ]
  },
  "exports": {
    "AuditLedger": { "type": "durable-object", "storage": "sqlite" },
    "MaintenanceScheduler": { "type": "durable-object", "storage": "sqlite" }
  },
  "ai_search_namespaces": [
    { "binding": "AI_SEARCH", "namespace": "default", "remote": true }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 12, "period": 60 }
    },
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "ADMIN_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
