    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.9.2",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.28.1"
  }
}
