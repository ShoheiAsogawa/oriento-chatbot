{
  "name": "@orient/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types src/worker-configuration.d.ts --strict-vars false",
    "build": "wrangler deploy --dry-run --outdir dist",
